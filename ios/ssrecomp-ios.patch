+// A translated build of the game shows its original text while its switch (a byte in main
+// RAM, found by name when the game was recompiled) is set, or while the DS debug button
+// (bit 3 of KEYXY, which no retail console has) is held. The frontend does both while the
+// original is asked for. pageTurn (-1 or 1) asks it to show the page before or after the one
+// of the message on screen; it adds up in another byte until the game has read it.
+static void SetOriginalText(NDS& nds, bool shown, int pageTurn)
+{
+    if (shown) nds.KeyInput &= ~(1u << 19);
+    else nds.KeyInput |= 1u << 19;
+    if (rc_original_text_flag) nds.MainRAM[rc_original_text_flag & nds.MainRAMMask] = shown ? 1 : 0;
+    if (rc_text_page_turn && pageTurn)
+    {
+        u8& turns = nds.MainRAM[rc_text_page_turn & nds.MainRAMMask];
+        turns = (u8)(int8_t)std::clamp((int8_t)turns + pageTurn, -16, 16);
+    }
+}
+
+// Plays one frame of the core's 48 kHz stereo output. The clock of the audio device and the
+// frame clock never quite agree, and a queue that runs dry between frames plays a short gap
+// of silence many times a second: a constant buzz. So about 50 ms are kept queued, and each
+// frame's samples are stretched or squeezed by up to 0.5% to hold that level, which changes
+// the pitch by too little to hear.
+static void QueueAudio(SDL_AudioDeviceID audio, const int16_t* in, int frames)
+{
+    static std::vector<int16_t> out;
+    static double level = -1, carry = 0;
+    static unsigned dry = 0;
+    static uint32_t reportedAt = 0;
+    const int target = 48000 / 20;
+    const int queued = (int)(SDL_GetQueuedAudioSize(audio) / 4);
+    if (queued > target * 4) return; // far behind, after a stall: drop rather than lag
+    if (queued == 0)
+    {
+        // Empty (at the start, after a pause or a stall): fill up to the level at once.
+        if (level >= 0) dry++;
+        out.assign((size_t)target * 2, 0);
+        SDL_QueueAudio(audio, out.data(), target * 4);
+        level = target;
+    }
+    // The queue drains in the device's blocks, so its level is smoothed before it is used.
+    if (level < 0) level = queued;
+    level += (queued + (queued == 0 ? target : 0) - level) * 0.05;
+    const double ratio = 1.0 + 0.005 * std::clamp((target - level) / target, -1.0, 1.0);
+    const double want = frames * ratio + carry;
+    const int n = (int)want;
+    carry = want - n;
+    if (frames < 2 || n < 2)
+    {
+        SDL_QueueAudio(audio, in, frames * 4);
+    }
+    else
+    {
+        out.resize((size_t)n * 2);
+        const double step = (double)(frames - 1) / (n - 1);
+        for (int i = 0; i < n; i++)
+        {
+            const double pos = i * step;
+            const int j = std::min((int)pos, frames - 2);
+            const double f = pos - j;
+            for (int c = 0; c < 2; c++)
+                out[i * 2 + c] = (int16_t)lrint(in[j * 2 + c] * (1 - f) + in[(j + 1) * 2 + c] * f);
+        }
+        SDL_QueueAudio(audio, out.data(), n * 4);
+    }
+    if (dry && SDL_GetTicks() - reportedAt > 10000)
+    {
+        fprintf(stderr, "[audio] the queue ran dry %u time(s)\n", dry);
+        dry = 0;
+        reportedAt = SDL_GetTicks();
+    }
+}
