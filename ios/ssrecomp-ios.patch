+namespace melonDS
+{
+#ifndef SSR_WIDE_GL
+bool WideGLReady() { return false; }
+void WideGLStart(WideGLFrame&) {}
+void WideGLWait() {}
+#else
+namespace
+{
+const char* kVS = R"(
+layout(location = 0) in vec4 vPos;    // x, y (pixels), DS depth, 1/W
+layout(location = 1) in vec4 vColor;  // 6-bit colour, W-buffer scale
+layout(location = 2) in vec2 vST;
+layout(location = 3) in uvec4 vAttr;
+layout(location = 4) in vec4 vBox;
+uniform vec2 uSize;
+out vec3 fColor;
+out vec2 fST;
+flat out vec4 fBox;
+flat out uvec4 fAttr;
+flat out float fWScale;
+void main()
+{
+    // The DS interpolates depth linearly across the screen and everything else with
+    // perspective, as the graphics chip does with z/w and the other outputs.
+    float w = 1.0 / vPos.w;
+    vec2 ndc = vPos.xy / uSize * 2.0 - 1.0;
+    float z = vPos.z / 8388608.0 - 1.0;
+    gl_Position = vec4(ndc * w, z * w, w);
+    fColor = vColor.rgb;
+    fWScale = vColor.a;
+    fST = vST;
+    fAttr = vAttr;
+    fBox = vBox;
+}
+)";
+
+// The same shading as GPU3D_Wide.cpp's, in the DS's own 6- and 5-bit steps.
+const char* kFS = R"(
+in vec3 fColor;
+in vec2 fST;
+flat in uvec4 fAttr;   // polygon attributes, texture parameters, atlas place, flags
+flat in float fWScale;
+flat in vec4 fBox;
+uniform usampler2D uAtlas;
+uniform uint uDispCnt;
+uniform int uAlphaRef;
+uniform int uToon[32];
+layout(location = 0) out vec4 oColor;
+layout(location = 1) out vec4 oFog;
+
+int Wrap(int c, int size, bool repeat, bool mirror)
+{
+    if (!repeat) return clamp(c, 0, size - 1);
+    int m = c & (size - 1);
+    if (mirror && (c & size) != 0) return size - 1 - m;
+    return m;
+}
+ivec3 Toon(int i)
+{
+    int tc = uToon[i];
+    ivec3 c = ivec3((tc << 1) & 0x3E, (tc >> 4) & 0x3E, (tc >> 9) & 0x3E);
+    return c + ivec3(notEqual(c, ivec3(0)));
+}
+void main()
+{
+    uint attr = fAttr.x;
+    int polyAlpha = int((attr >> 16) & 31u);
+    int blendMode = int((attr >> 4) & 3u);
+    bool highlight = blendMode == 2 && (uDispCnt & 2u) != 0u;
+    bool toon = blendMode == 2 && !highlight;
+    bool textured = (fAttr.w & 1u) != 0u;
+    int alpha = polyAlpha;
+    uvec4 tx = uvec4(0u);
+    if (textured)
+    {
+        uint tp = fAttr.y;
+        int tw = 8 << int((tp >> 20) & 7u), th = 8 << int((tp >> 23) & 7u);
+        ivec2 st = ivec2(floor(clamp(fST, fBox.xy, fBox.zw) / 16.0));
+        st.x = Wrap(st.x, tw, (tp & 0x10000u) != 0u, (tp & 0x40000u) != 0u);
+        st.y = Wrap(st.y, th, (tp & 0x20000u) != 0u, (tp & 0x80000u) != 0u);
+        tx = texelFetch(uAtlas, ivec2(int(fAttr.z & 0xFFFFu), int(fAttr.z >> 16)) + st, 0);
+        if ((blendMode & 1) == 0) alpha = ((int(tx.a) + 1) * (polyAlpha + 1) - 1) >> 5;
+    }
+    if (polyAlpha == 0) alpha = 31; // wireframe polygons are drawn filled
+    if (alpha <= uAlphaRef) discard;
+
+    ivec3 v = clamp(ivec3(fColor + 0.5), 0, 63);
+    int rawR = v.r;
+    if (highlight) v = ivec3(v.r);
+    else if (toon) v = Toon(v.r >> 1);
+    ivec3 c = v;
+    if (textured)
+    {
+        ivec3 t = ivec3(tx.rgb);
+        int ta = int(tx.a);
+        if ((blendMode & 1) != 0)
+        {
+            // decal
+            if (ta == 31) c = t;
+            else if (ta != 0) c = (t * ta + v * (31 - ta)) >> 5;
+        }
+        else
+            c = ((t + 1) * (v + 1) - 1) >> 6; // modulate
+    }
+    if (highlight) c = min(c + Toon(rawR >> 1), ivec3(63));
+    c = (c << 2) | (c >> 4);
+    // Blue first: read back as bytes, the picture is then XRGB like the processor's. The
+    // alpha is the blending weight; the picture keeps the largest (GL_MAX).
+    oColor = vec4(vec3(c.bgr) / 255.0, float(alpha + 1) / 32.0);
+    oFog = vec4(float((attr >> 15) & 1u), 0.0, 0.0, 0.0);
+#ifdef WBUFFER
+    gl_FragDepth = clamp(fWScale / gl_FragCoord.w / 16777216.0, 0.0, 1.0);
+#endif
+}
+)";
+
+const char* kFullVS = R"(
+void main()
+{
+    vec2 p = vec2(gl_VertexID == 1 ? 3.0 : -1.0, gl_VertexID == 2 ? 3.0 : -1.0);
+    gl_Position = vec4(p, 0.0, 1.0);
+}
+)";
+
+const char* kFogFS = R"(
+uniform sampler2D uDepth;
+uniform sampler2D uFogFlag;
+uniform int uDensity[34];
+uniform uint uFogOffset, uFogShift;
+uniform vec3 uFogColor;
+layout(location = 0) out vec4 oColor;
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    if (texelFetch(uFogFlag, p, 0).r < 0.5) discard;
+    uint z = uint(min(texelFetch(uDepth, p, 0).r * 16777216.0 + 0.5, 16777215.0));
+    uint id = 0u, frac = 0u;
+    if (z >= uFogOffset)
+    {
+        z = ((z - uFogOffset) >> 2) << uFogShift;
+        id = z >> 17;
+        if (id >= 32u) id = 32u;
+        else frac = z & 0x1FFFFu;
+    }
+    uint density = (uint(uDensity[int(id)]) * (0x20000u - frac) + uint(uDensity[int(id) + 1]) * frac) >> 17;
+    if (density >= 127u) density = 128u;
+    if (density == 0u) discard;
+    oColor = vec4(uFogColor, float(density) / 128.0);
+}
+)";
+
+GLuint Compile(GLenum type, const char* defines, const char* src, std::string& err)
+{
+    GLuint s = glCreateShader(type);
+    const char* parts[3] = { SSR_GLSL_HEADER, defines, src };
+    glShaderSource(s, 3, parts, nullptr);
+    glCompileShader(s);
+    GLint ok = 0;
+    glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+    if (!ok)
+    {
+        char log[2048] = {};
+        glGetShaderInfoLog(s, sizeof(log), nullptr, log);
+        err = log;
+        glDeleteShader(s);
+        return 0;
+    }
+    return s;
+}
+
+GLuint Link(const char* vs, const char* fs, const char* defines, std::string& err)
+{
+    GLuint v = Compile(GL_VERTEX_SHADER, "", vs, err);
+    if (!v) return 0;
+    GLuint f = Compile(GL_FRAGMENT_SHADER, defines, fs, err);
+    if (!f)
+    {
+        glDeleteShader(v);
+        return 0;
+    }
+    GLuint p = glCreateProgram();
+    glAttachShader(p, v);
+    glAttachShader(p, f);
+    glLinkProgram(p);
+    glDeleteShader(v);
+    glDeleteShader(f);
+    GLint ok = 0;
+    glGetProgramiv(p, GL_LINK_STATUS, &ok);
+    if (!ok)
+    {
+        char log[2048] = {};
+        glGetProgramInfoLog(p, sizeof(log), nullptr, log);
+        err = log;
+        glDeleteProgram(p);
+        return 0;
+    }
+    return p;
+}
+
+class Renderer
+{
+public:
+    // On the drawing thread: makes the context and everything that does not depend on the
+    // picture's size. Returns an empty string, or what went wrong.
+    std::string Init()
+    {
+        std::string err = MakeContext();
+        if (!err.empty()) return err;
+        for (int w = 0; w < 2; w++)
+        {
+            Program[w] = Link(kVS, kFS, w ? "#define WBUFFER\n" : "", err);
+            if (!Program[w]) return "polygon shader: " + err;
+        }
+        FogProgram = Link(kFullVS, kFogFS, "", err);
+        if (!FogProgram) return "fog shader: " + err;
+
+        glGenVertexArrays(1, &Vao);
+        glGenBuffers(1, &Vbo);
+        glBindVertexArray(Vao);
+        glBindBuffer(GL_ARRAY_BUFFER, Vbo);
+        const GLsizei stride = sizeof(WideGLVertex);
+        glEnableVertexAttribArray(0);
+        glVertexAttribPointer(0, 4, GL_FLOAT, GL_FALSE, stride, (void*)offsetof(WideGLVertex, X));
+        glEnableVertexAttribArray(1);
+        glVertexAttribPointer(1, 4, GL_FLOAT, GL_FALSE, stride, (void*)offsetof(WideGLVertex, R));
+        glEnableVertexAttribArray(2);
+        glVertexAttribPointer(2, 2, GL_FLOAT, GL_FALSE, stride, (void*)offsetof(WideGLVertex, S));
+        glEnableVertexAttribArray(3);
+        glVertexAttribIPointer(3, 4, GL_UNSIGNED_INT, stride, (void*)offsetof(WideGLVertex, Attr));
+        glEnableVertexAttribArray(4);
+        glVertexAttribPointer(4, 4, GL_FLOAT, GL_FALSE, stride, (void*)offsetof(WideGLVertex, S0));
+        glGenVertexArrays(1, &EmptyVao);
+
+        glGenTextures(1, &Atlas);
+        glBindTexture(GL_TEXTURE_2D, Atlas);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8UI, WideGLAtlasW, WideGLAtlasH, 0, GL_RGBA_INTEGER, GL_UNSIGNED_BYTE, nullptr);
+        Nearest();
+
+        for (int p = 0; p < 2; p++)
+        {
+            glUseProgram(Program[p]);
+            glUniform1i(glGetUniformLocation(Program[p], "uAtlas"), 0);
+        }
+        glUseProgram(FogProgram);
+        glUniform1i(glGetUniformLocation(FogProgram, "uDepth"), 0);
+        glUniform1i(glGetUniformLocation(FogProgram, "uFogFlag"), 1);
+        if (GLenum e = glGetError()) return "setup failed, error " + std::to_string(e);
+        return "";
+    }
+
+    void Draw(WideGLFrame& f)
+    {
+        const auto t0 = std::chrono::steady_clock::now();
+        Resize(f.W, f.H);
+
+        // Textures, decoded whole into the atlas.
+        glActiveTexture(GL_TEXTURE0);
+        glBindTexture(GL_TEXTURE_2D, Atlas);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+        for (const WideGLTexture& t : f.Textures)
+        {
+            Staging.resize((size_t)t.W * t.H * 4);
+            f.Decode(t.Param, t.Palette, t.W, t.H, Staging.data());
+            glTexSubImage2D(GL_TEXTURE_2D, 0, t.X, t.Y, t.W, t.H, GL_RGBA_INTEGER, GL_UNSIGNED_BYTE, Staging.data());
+        }
+
+        glBindFramebuffer(GL_FRAMEBUFFER, Fbo);
+        glViewport(0, 0, f.W, f.H);
+        static const GLenum both[2] = { GL_COLOR_ATTACHMENT0, GL_COLOR_ATTACHMENT1 };
+        static const GLenum colourOnly[2] = { GL_COLOR_ATTACHMENT0, GL_NONE };
+        glDrawBuffers(2, both);
+        glDisable(GL_BLEND);
+        glDisable(GL_SCISSOR_TEST);
+        glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+        glDepthMask(GL_TRUE);
+        glStencilMask(0xFF);
+        const GLfloat clear[4] = { (f.ClearColor & 0xFF) / 255.0f, ((f.ClearColor >> 8) & 0xFF) / 255.0f,
+            ((f.ClearColor >> 16) & 0xFF) / 255.0f, (f.ClearColor >> 24) ? 1.0f : 0.0f };
+        glClearBufferfv(GL_COLOR, 0, clear);
+        const GLfloat fogClear[4] = { f.ClearFog ? 1.0f : 0.0f, 0, 0, 0 };
+        glClearBufferfv(GL_COLOR, 1, fogClear);
+        glClearBufferfi(GL_DEPTH_STENCIL, 0, (float)(f.ClearZ / 16777216.0), 0);
+
+        if (!f.Vertices.empty())
+        {
+            glBindVertexArray(Vao);
+            glBindBuffer(GL_ARRAY_BUFFER, Vbo);
+            const size_t vsize = f.Vertices.size() * sizeof(WideGLVertex), usize = f.Under.size() * sizeof(WideGLVertex);
+            glBufferData(GL_ARRAY_BUFFER, vsize + usize, nullptr, GL_STREAM_DRAW);
+            glBufferSubData(GL_ARRAY_BUFFER, 0, vsize, f.Vertices.data());
+            if (usize) glBufferSubData(GL_ARRAY_BUFFER, vsize, usize, f.Under.data());
+            const GLuint prog = Program[f.WBuffer ? 1 : 0];
+            glUseProgram(prog);
+            glUniform2f(glGetUniformLocation(prog, "uSize"), (float)f.W, (float)f.H);
+            glUniform1ui(glGetUniformLocation(prog, "uDispCnt"), f.DispCnt);
+            glUniform1i(glGetUniformLocation(prog, "uAlphaRef"), (GLint)f.AlphaRef);
+            GLint toon[32];
+            for (int i = 0; i < 32; i++) toon[i] = f.Toon[i];
+            glUniform1iv(glGetUniformLocation(prog, "uToon"), 32, toon);
+
+            glEnable(GL_DEPTH_TEST);
+            glEnable(GL_STENCIL_TEST);
+            glStencilOp(GL_KEEP, GL_KEEP, GL_REPLACE);
+            const bool blend = f.DispCnt & (1 << 3);
+            glBlendEquationSeparate(GL_FUNC_ADD, GL_MAX);
+            if (blend)
+                glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE);
+            else
+                glBlendFuncSeparate(GL_ONE, GL_ZERO, GL_ONE, GL_ONE);
+            // The grown polygons, then the depth cleared again for the polygons as they are.
+            if (!f.UnderBatches.empty())
+            {
+                glDisable(GL_BLEND);
+                glDrawBuffers(2, both);
+                glDepthMask(GL_TRUE);
+                glStencilFunc(GL_ALWAYS, 0, 0xFF);
+                const GLint base = (GLint)f.Vertices.size();
+                for (const WideGLBatch& b : f.UnderBatches)
+                {
+                    glDepthFunc(b.DepthEqual ? GL_LEQUAL : GL_LESS);
+                    if (b.DepthEqual)
+                    {
+                        glEnable(GL_POLYGON_OFFSET_FILL);
+                        glPolygonOffset(0.0f, -256.0f);
+                    }
+                    else
+                        glDisable(GL_POLYGON_OFFSET_FILL);
+                    glDrawArrays(GL_TRIANGLES, base + b.First, b.Count);
+                }
+                glClearBufferfi(GL_DEPTH_STENCIL, 0, (float)(f.ClearZ / 16777216.0), 0);
+            }
+            for (const WideGLBatch& b : f.Batches)
+            {
+                // On equal depth the polygon drawn first stays, as on the DS (GL_LESS);
+                // those that ask for equal depth pass within a little of it.
+                glDepthFunc(b.DepthEqual ? GL_LEQUAL : GL_LESS);
+                if (b.DepthEqual)
+                {
+                    glEnable(GL_POLYGON_OFFSET_FILL);
+                    glPolygonOffset(0.0f, -256.0f);
+                }
+                else
+                    glDisable(GL_POLYGON_OFFSET_FILL);
+                if (b.Translucent)
+                {
+                    // Translucent pixels of one polygon ID are not drawn over each other: the
+                    // stencil holds the ID of the last translucent polygon, 0 after an opaque one.
+                    glEnable(GL_BLEND);
+                    glDrawBuffers(2, colourOnly); // the fog flag stays the one underneath
+                    glDepthMask(b.DepthWrite ? GL_TRUE : GL_FALSE);
+                    glStencilFunc(GL_NOTEQUAL, b.PolyId, 0xFF);
+                }
+                else
+                {
+                    glDisable(GL_BLEND);
+                    glDrawBuffers(2, both);
+                    glDepthMask(GL_TRUE);
+                    glStencilFunc(GL_ALWAYS, 0, 0xFF);
+                }
+                glDrawArrays(GL_TRIANGLES, b.First, b.Count);
+            }
+            glDisable(GL_POLYGON_OFFSET_FILL);
+            glDisable(GL_STENCIL_TEST);
+            glDisable(GL_DEPTH_TEST);
+        }
+
+        if (f.Fog)
+        {
+            glBindFramebuffer(GL_FRAMEBUFFER, FogFbo);
+            glDrawBuffers(1, both);
+            glEnable(GL_BLEND);
+            glBlendEquationSeparate(GL_FUNC_ADD, GL_FUNC_ADD);
+            glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ZERO, GL_ONE);
+            glUseProgram(FogProgram);
+            GLint density[34];
+            for (int i = 0; i < 34; i++) density[i] = f.FogDensity[i];
+            glUniform1iv(glGetUniformLocation(FogProgram, "uDensity"), 34, density);
+            glUniform1ui(glGetUniformLocation(FogProgram, "uFogOffset"), f.FogOffset);
+            glUniform1ui(glGetUniformLocation(FogProgram, "uFogShift"), f.FogShift);
+            glUniform3f(glGetUniformLocation(FogProgram, "uFogColor"), (f.FogColor & 0xFF) / 255.0f,
+                ((f.FogColor >> 8) & 0xFF) / 255.0f, ((f.FogColor >> 16) & 0xFF) / 255.0f);
+            glActiveTexture(GL_TEXTURE1);
+            glBindTexture(GL_TEXTURE_2D, FogFlag);
+            glActiveTexture(GL_TEXTURE0);
+            glBindTexture(GL_TEXTURE_2D, Depth);
+            glBindVertexArray(EmptyVao);
+            glDrawArrays(GL_TRIANGLES, 0, 3);
+            glDisable(GL_BLEND);
+        }
+
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, Fbo);
+        glReadBuffer(GL_COLOR_ATTACHMENT0);
+        glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        glReadPixels(0, 0, f.W, f.H, GL_RGBA, GL_UNSIGNED_BYTE, f.Out);
+
+        static int errors = 0;
+        if (GLenum e = glGetError(); e && errors < 5)
+        {
+            errors++;
+            fprintf(stderr, "[wide] graphics chip error %u\n", e);
+        }
+        if (f.Done)
+            f.Done((u64)std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count());
+    }
+
+private:
+    GLuint Program[2] = {}, FogProgram = 0, Vao = 0, EmptyVao = 0, Vbo = 0, Atlas = 0;
+    GLuint Fbo = 0, FogFbo = 0, Colour = 0, FogFlag = 0, Depth = 0;
+    int W = 0, H = 0;
+    std::vector<u8> Staging;
+
+    static void Nearest()
+    {
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+
+    void Resize(int w, int h)
+    {
+        if (w == W && h == H) return;
+        if (Fbo)
+        {
+            glDeleteFramebuffers(1, &Fbo);
+            glDeleteFramebuffers(1, &FogFbo);
+            GLuint tex[3] = { Colour, FogFlag, Depth };
+            glDeleteTextures(3, tex);
+        }
+        W = w;
+        H = h;
+        GLuint tex[3];
+        glGenTextures(3, tex);
+        Colour = tex[0];
+        FogFlag = tex[1];
+        Depth = tex[2];
+        glBindTexture(GL_TEXTURE_2D, Colour);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        Nearest();
+        glBindTexture(GL_TEXTURE_2D, FogFlag);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_R8, w, h, 0, GL_RED, GL_UNSIGNED_BYTE, nullptr);
+        Nearest();
+        glBindTexture(GL_TEXTURE_2D, Depth);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH24_STENCIL8, w, h, 0, GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8, nullptr);
+        Nearest();
+        glGenFramebuffers(1, &Fbo);
+        glBindFramebuffer(GL_FRAMEBUFFER, Fbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, Colour, 0);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT1, GL_TEXTURE_2D, FogFlag, 0);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, Depth, 0);
+        if (GLenum s = glCheckFramebufferStatus(GL_FRAMEBUFFER); s != GL_FRAMEBUFFER_COMPLETE)
+            fprintf(stderr, "[wide] graphics chip: picture buffer incomplete (%x)\n", s);
+        // Fog is drawn over the colour while reading the depth and the fog flags.
+        glGenFramebuffers(1, &FogFbo);
+        glBindFramebuffer(GL_FRAMEBUFFER, FogFbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, Colour, 0);
+    }
+
+#if defined(__ANDROID__)
+    std::string MakeContext()
+    {
+        EGLDisplay d = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+        if (d == EGL_NO_DISPLAY || !eglInitialize(d, nullptr, nullptr)) return "no EGL display";
+        const EGLint cfgAttr[] = { EGL_RENDERABLE_TYPE, 0x40 /* EGL_OPENGL_ES3_BIT */, EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,
+            EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_NONE };
+        EGLConfig cfg;
+        EGLint n = 0;
+        if (!eglChooseConfig(d, cfgAttr, &cfg, 1, &n) || n < 1) return "no OpenGL ES 3 configuration";
+        const EGLint ctxAttr[] = { EGL_CONTEXT_CLIENT_VERSION, 3, EGL_NONE };
+        EGLContext c = eglCreateContext(d, cfg, EGL_NO_CONTEXT, ctxAttr);
+        if (c == EGL_NO_CONTEXT) return "no OpenGL ES 3 context";
+        const EGLint surfAttr[] = { EGL_WIDTH, 1, EGL_HEIGHT, 1, EGL_NONE };
+        EGLSurface s = eglCreatePbufferSurface(d, cfg, surfAttr);
+        if (s == EGL_NO_SURFACE || !eglMakeCurrent(d, s, s, c)) return "could not use the context";
+        fprintf(stderr, "[wide] graphics chip: %s, %s\n", (const char*)glGetString(GL_RENDERER), (const char*)glGetString(GL_VERSION));
+        return "";
+    }
+#else
+    std::string MakeContext()
+    {
+        const CGLPixelFormatAttribute attrs[] = { kCGLPFAOpenGLProfile, (CGLPixelFormatAttribute)kCGLOGLPVersion_3_2_Core,
+            kCGLPFAAllowOfflineRenderers, (CGLPixelFormatAttribute)0 };
+        CGLPixelFormatObj pf = nullptr;
+        GLint n = 0;
+        if (CGLChoosePixelFormat(attrs, &pf, &n) != kCGLNoError || !pf) return "no OpenGL 3.2 pixel format";
+        CGLContextObj ctx = nullptr;
+        CGLError e = CGLCreateContext(pf, nullptr, &ctx);
+        CGLDestroyPixelFormat(pf);
+        if (e != kCGLNoError || !ctx) return "no OpenGL 3.2 context";
+        CGLSetCurrentContext(ctx);
+        fprintf(stderr, "[wide] graphics chip: %s, %s\n", (const char*)glGetString(GL_RENDERER), (const char*)glGetString(GL_VERSION));
+        return "";
+    }
+#endif
+};
+
+// The drawing thread: the context belongs to it.
+class Thread
+{
+public:
+    bool Ready()
+    {
+        std::unique_lock<std::mutex> lock(Mutex);
+        if (State == 0)
+        {
+            State = 1;
+            T = std::thread([this] { Loop(); });
+            T.detach();
+        }
+        Changed.wait(lock, [this] { return State != 1; });
+        return State == 2;
+    }
+    void Start(WideGLFrame& f)
+    {
+        {
+            std::lock_guard<std::mutex> lock(Mutex);
+            Job = &f;
+        }
+        Changed.notify_all();
+    }
+    void Wait()
+    {
+        std::unique_lock<std::mutex> lock(Mutex);
+        Changed.wait(lock, [this] { return Job == nullptr; });
+    }
+
+private:
+    std::thread T;
+    std::mutex Mutex;
+    std::condition_variable Changed;
+    int State = 0; // 0 not started, 1 setting up, 2 ready, 3 failed
+    WideGLFrame* Job = nullptr;
+
+    void Loop()
+    {
+        // SSR_HELPER_CPUS, if set, moves this thread off the emulation's cores (see main.cpp).
+        WideUseCpus("SSR_HELPER_CPUS");
+        Renderer r;
+        const std::string err = r.Init();
+        {
+            std::lock_guard<std::mutex> lock(Mutex);
+            State = err.empty() ? 2 : 3;
+        }
+        if (!err.empty()) fprintf(stderr, "[wide] graphics chip: %s; drawing on the processor\n", err.c_str());
+        Changed.notify_all();
+        if (!err.empty()) return;
+        for (;;)
+        {
+            WideGLFrame* f;
+            {
+                std::unique_lock<std::mutex> lock(Mutex);
+                Changed.wait(lock, [this] { return Job != nullptr; });
+                f = Job;
+            }
+            r.Draw(*f);
+            {
+                std::lock_guard<std::mutex> lock(Mutex);
+                Job = nullptr;
+            }
+            Changed.notify_all();
+        }
+    }
+};
+Thread GLThread;
+}
+
+bool WideGLReady()
+{
+    // On by default on Android, where the processor is the limit; on macOS only for tests.
+    static const bool wanted = [] {
+        const char* e = getenv("SSR_WIDE_GPU");
+#if defined(__ANDROID__)
+        return !e || atoi(e) != 0;
+#else
+        return e && atoi(e) != 0;
+#endif
+    }();
+    return wanted && GLThread.Ready();
+}
+void WideGLStart(WideGLFrame& frame) { GLThread.Start(frame); }
+void WideGLWait() { GLThread.Wait(); }
+#endif
+}
diff --git a/melonDS/src/GPU3D_WideGL.h b/melonDS/src/GPU3D_WideGL.h
new file mode 100644
index 0000000..d510892
--- /dev/null
+++ b/melonDS/src/GPU3D_WideGL.h
@@ -0,0 +1,83 @@
+// ssrecomp: the widescreen 3D scene (GPU3D_Wide.h) drawn by the graphics chip instead of the
+// processor, with OpenGL ES 3 on Android and OpenGL 3.2 on macOS (for testing). It draws the
+// polygons GPU3D_Wide.cpp prepares into an image of the same kind as its own (XRGB, the top
+// byte the 3D alpha), on a thread of its own with a context of its own, apart from the
+// frontend's. Where it is not available GPU3D_Wide.cpp draws the scene itself.
+#pragma once
+#include <atomic>
+#include <functional>
+#include <vector>
+#include "types.h"
+
+namespace melonDS
+{
+struct WideGLVertex
+{
+    float X, Y, Z, InvW;  // output pixels; depth as the DS stores it; 1 / normalised W
+    float R, G, B, WScale; // 6-bit colour; for W-buffering, depth = WScale / interpolated InvW
+    float S, T;           // texture coordinates, 1/16 texel
+    u32 Attr, TexParam;   // the polygon's
+    u32 Atlas;            // where its texture is in the atlas: x | y << 16
+    u32 Flags;            // bit 0: textured
+    // The texture coordinates are kept within these (the polygon's own texels): the
+    // polygons of the first pass are grown a little, and their edges must not sample
+    // from beyond them.
+    float S0, T0, S1, T1;
+};
+
+// A run of polygons drawn with the same settings.
+struct WideGLBatch
+{
+    u32 First, Count;  // vertices
+    bool Translucent;
+    bool DepthEqual;   // passes on (nearly) equal depth (polygon attribute bit 14)
+    bool DepthWrite;   // translucent polygons write depth only when asked (bit 11)
+    u8 PolyId;         // translucent: ID + 1
+};
+
+struct WideGLTexture
+{
+    u32 Param, Palette;
+    int X, Y, W, H;    // place in the atlas
+};
+
+struct WideGLFrame
+{
+    int W = 0, H = 0;
+    std::vector<WideGLVertex> Vertices;
+    std::vector<WideGLBatch> Batches;
+    // Drawn first: the opaque polygons grown by a third of a pixel, as GPU3D_Wide.cpp grows
+    // them, which fills the slivers left open where polygons meet. The polygons as they are
+    // (Vertices) are then drawn over them.
+    std::vector<WideGLVertex> Under;
+    std::vector<WideGLBatch> UnderBatches;
+    std::vector<WideGLTexture> Textures;
+    // Decodes a whole texture: 4 bytes a texel, red, green, blue (6 bits) and alpha (5 bits).
+    std::function<void(u32 param, u32 palette, int w, int h, u8* out)> Decode;
+
+    u32 ClearColor = 0;     // XRGB with the 3D alpha on top, as in the output
+    u32 ClearZ = 0;
+    bool ClearFog = false;
+    bool WBuffer = false;
+    u32 DispCnt = 0, AlphaRef = 0;
+    u16 Toon[32] = {};
+    u8 FogDensity[34] = {};
+    u32 FogOffset = 0, FogShift = 0, FogColor = 0; // FogColor: 8-bit XRGB
+    bool Fog = false;
+
+    u32* Out = nullptr;     // W * H pixels, written by the time WideGLWait() returns
+    // Told how long the picture took, in microseconds, when it is done.
+    std::function<void(u64)> Done;
+};
+
+// Atlas size the frames' textures are placed in.
+constexpr int WideGLAtlasW = 2048, WideGLAtlasH = 2048;
+
+// Whether the graphics chip is to draw (SSR_WIDE_GPU=0 or 1; on Android it does unless
+// told not to) and could be set up. The first call
+// sets it up, on the drawing thread; it is not tried again after a failure.
+bool WideGLReady();
+// Starts drawing the frame; it must stay as it is until WideGLWait().
+void WideGLStart(WideGLFrame& frame);
+void WideGLWait();
+}
