diff --git a/cmake/IOSDependencies.cmake b/cmake/IOSDependencies.cmake
new file mode 100644
index 0000000..b256ef8
--- /dev/null
+++ b/cmake/IOSDependencies.cmake
@@ -0,0 +1,22 @@
+# SDL2 for iOS, built from source as a static library with the app. The URL and checksum are
+# those MacDependencies.cmake uses; SSR_SDL2_SOURCE_DIR points at an unpacked copy instead.
+include(FetchContent)
+set(FETCHCONTENT_QUIET OFF)
+if(POLICY CMP0135)
+    cmake_policy(SET CMP0135 NEW)
+endif()
+
+set(SDL_SHARED OFF CACHE BOOL "" FORCE)
+set(SDL_STATIC ON CACHE BOOL "" FORCE)
+set(SDL_TEST OFF CACHE BOOL "" FORCE)
+set(SDL_TESTS OFF CACHE BOOL "" FORCE)
+if(SSR_SDL2_SOURCE_DIR)
+    FetchContent_Declare(ssr_sdl2 SOURCE_DIR "${SSR_SDL2_SOURCE_DIR}")
+else()
+    FetchContent_Declare(ssr_sdl2
+        URL https://www.libsdl.org/release/SDL2-2.32.10.tar.gz
+        TIMEOUT 90
+        TLS_VERIFY TRUE
+        URL_HASH SHA256=5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165)
+endif()
+FetchContent_MakeAvailable(ssr_sdl2)
