+// A translated build of the game shows its original text while its switch (a byte in main
+// RAM, found by name when the game was recompiled) is set, or while the DS debug button
+// (bit 3 of KEYXY, which no retail console has) is held. The frontend does both while the
+// original is asked for. pageTurn (-1 or 1) asks it to show the page before or after the one
+// of the message on screen; it adds up in another byte until the game has read it.
+static void SetOriginalText(NDS& nds, bool shown, int pageTurn)
+{
+    if (shown) nds.KeyInput &= ~(1u << 19);
+    else nds.KeyInput |= 1u << 19;
+    if (rc_original_text_flag) nds.MainRAM[rc_original_text_flag & nds.MainRAMMask] = shown ? 1 : 0;
+    if (rc_text_page_turn && pageTurn)
+    {
+        u8& turns = nds.MainRAM[rc_text_page_turn & nds.MainRAMMask];
+        turns = (u8)(int8_t)std::clamp((int8_t)turns + pageTurn, -16, 16);
+    }
+}
+
+// The DS mixes at 32768 Hz and holds each sample until the next, and many instruments are
+// recorded at lower rates still: copies of the music mirrored above those rates come out as a
+// thin high hiss. With sound smoothing on, the 48 kHz output also goes through a steep
+// low-pass filter (fourth-order Butterworth at 12 kHz), above which the DS has little else.
+static void FilterAudio(int16_t* buf, int frames, bool on)
+{
+    struct Biquad { double b0, b1, b2, a1, a2; double z1[2], z2[2]; };
+    static Biquad stages[2];
+    static bool ready = false;
+    if (!on)
+    {
+        ready = false;
+        return;
+    }
+    if (!ready)
+    {
+        const double qs[2] = { 0.5412, 1.3066 };
+        const double w = 2 * 3.14159265358979 * 12000.0 / 48000.0, c = cos(w);
+        for (int i = 0; i < 2; i++)
+        {
+            const double al = sin(w) / (2 * qs[i]), a0 = 1 + al;
+            stages[i] = { (1 - c) / 2 / a0, (1 - c) / a0, (1 - c) / 2 / a0, -2 * c / a0, (1 - al) / a0, { 0, 0 }, { 0, 0 } };
+        }
+        ready = true;
+    }
+    for (int n = 0; n < frames; n++)
+        for (int ch = 0; ch < 2; ch++)
+        {
+            double v = buf[n * 2 + ch];
+            for (Biquad& q : stages)
+            {
+                const double y = q.b0 * v + q.z1[ch];
+                q.z1[ch] = q.b1 * v - q.a1 * y + q.z2[ch];
+                q.z2[ch] = q.b2 * v - q.a2 * y;
+                v = y;
+            }
+            buf[n * 2 + ch] = (int16_t)std::clamp(lrint(v), -32768L, 32767L);
+        }
+}
+
+// Plays one frame of the core's 48 kHz stereo output. The clock of the audio device and the
+// frame clock never quite agree, and a queue that runs dry between frames plays a short gap
+// of silence: a click, or a buzz if it happens many times a second. So about 80 ms are kept
+// queued (a phone can take a while over a frame now and then), and the samples are played
+// slightly faster or slower, by up to 0.5%, to hold that level, which changes the pitch by
+// too little to hear. The stretching carries on from one frame to the next without a seam.
+//
+// Fast-forwarding (speed frames of the game in one), there is more sound than time to play
+// it: as much is played as the time since the last call takes, at its own pitch, from the
+// start of what the frames made, and the rest is left out. Each piece is joined to the one
+// before with a short crossfade from where that one was cut, so the joins do not click.
+static void QueueAudio(SDL_AudioDeviceID audio, const int16_t* in, int frames, int speed = 1)
+{
+    constexpr int fade = 128;            // samples (2.7 ms) of crossfade at a join
+    static int16_t tail[fade * 2];       // what followed the last piece played, to fade from
+    static bool haveTail = false;
+    static uint64_t lastCall = 0;
+    static std::vector<int16_t> piece;
+    const uint64_t now = SDL_GetPerformanceCounter();
+    const double dt = lastCall ? std::min((double)(now - lastCall) / SDL_GetPerformanceFrequency(), 0.1) : 1.0 / 60;
+    lastCall = now;
+    if (speed > 1 && frames > fade * 2)
+    {
+        const int keep = std::clamp((int)lrint(48000 * dt), 1, frames - fade);
+        piece.assign(in, in + keep * 2);
+        if (haveTail)
+            for (int i = 0; i < fade; i++)
+                for (int c = 0; c < 2; c++)
+                {
+                    const float w = (i + 0.5f) / fade;
+                    piece[i * 2 + c] = (int16_t)lrintf(tail[i * 2 + c] * (1 - w) + piece[i * 2 + c] * w);
+                }
+        memcpy(tail, in + keep * 2, sizeof(tail));
+        haveTail = true;
+        in = piece.data();
+        frames = keep;
+    }
+    else if (haveTail)
+    {
+        // Back to normal speed: one last join.
+        piece.assign(in, in + frames * 2);
+        for (int i = 0; i < std::min(fade, frames); i++)
+            for (int c = 0; c < 2; c++)
+            {
+                const float w = (i + 0.5f) / fade;
+                piece[i * 2 + c] = (int16_t)lrintf(tail[i * 2 + c] * (1 - w) + piece[i * 2 + c] * w);
+            }
+        haveTail = false;
+        in = piece.data();
+    }
+    static std::vector<int16_t> out;
+    static double level = -1;
+    // Where the next output sample is read, in input samples from the start of this frame's;
+    // -1 to 0 is between the last sample of the frame before (prev) and the first of this one.
+    static double pos = 0;
+    static int16_t prev[2] = { 0, 0 };
+    static unsigned dry = 0;
+    static uint32_t reportedAt = 0;
+    const int target = 48000 * 8 / 100;
+    const int queued = (int)(SDL_GetQueuedAudioSize(audio) / 4);
+    if (frames < 1) return;
+    if (queued > target * 4)
+    {
+        // Far behind, after a stall: dropped rather than heard late.
+        prev[0] = in[frames * 2 - 2];
+        prev[1] = in[frames * 2 - 1];
+        pos = 0;
+        return;
+    }
+    if (queued == 0)
+    {
+        // Empty (at the start, after a pause or a stall): filled up to the level at once.
+        if (level >= 0) dry++;
+        out.assign((size_t)target * 2, 0);
+        SDL_QueueAudio(audio, out.data(), target * 4);
+        level = target;
+    }
+    // The queue drains in the device's blocks, so its level is smoothed before it is used.
+    if (level < 0) level = queued;
+    level += (queued + (queued == 0 ? target : 0) - level) * 0.05;
+    const double ratio = 1.0 + 0.005 * std::clamp((target - level) / target, -1.0, 1.0);
+    const double step = 1.0 / ratio;
+    out.clear();
+    for (; pos < frames - 1; pos += step)
+    {
+        const int j = (int)std::floor(pos);
+        const double f = pos - j;
+        for (int c = 0; c < 2; c++)
+        {
+            const double a = j < 0 ? prev[c] : in[j * 2 + c];
+            const double b = in[(j + 1) * 2 + c];
+            out.push_back((int16_t)lrint(a + (b - a) * f));
+        }
+    }
+    pos -= frames;
